# ═══════════════════════════════════════════════════════════════════════════
# Ugly-Website → Free Rebuild Outreach  ·  env template
# Copy to .env.local (git-ignored) and fill in. Extends the live the existing stack.
# Funnel: CALL-FIRST → opt-in → text the demo link.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Lead finding (scraper) ─────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...                 # Places API (New) + PageSpeed Insights

# ─── Vision (site-look scoring) — OpenAI-compatible, swappable ──────────────
VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_MODEL=qwen/qwen3.5-397b-a17b
VISION_API_KEY=nvapi-...               # NVIDIA (eval) — for production swap to Groq/Gemini/Ollama

# ─── Close CRM (REUSE the outreach — org: your CRM org) ────────────────────────
CLOSE_API_KEY=api_...                  # reuse from DEV/.env
CLOSE_SMS_NUMBER=+1XXXXXXXXXX          # your live 10DLC number(s), comma-separated
CLOSE_WEBHOOK_SECRET=

# ─── Convex (NEW dedicated DB for this project — create via `npx convex dev`) ─
# Kept separate from the outreach's a separate deployment so the rebuild line's data is isolated.
CONVEX_DEPLOYMENT=dev:your-new-deployment
CONVEX_URL=https://your-new-deployment.convex.cloud
CONVEX_SITE_URL=https://your-new-deployment.convex.site

# ─── Demo hosting (NEW — provision to go live) ──────────────────────────────
VERCEL_TOKEN=                          # Vercel API token
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID_TEMPLATES=
PUBLIC_DOMAIN=yourdomain.com           # short links + {slug}.demo.yourdomain.com
DEMO_SUBDOMAIN_SUFFIX=demo.yourdomain.com

# ─── Line-type scrub (before any texting) ───────────────────────────────────
TWILIO_ACCOUNT_SID=                    # or reuse scrap model scrub-mobiles setup
TWILIO_AUTH_TOKEN=

# ─── Payment / close (NEW) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_LAUNCH=                   # $1,000 launch
STRIPE_PRICE_HOSTING=                  # $99/mo

# ─── n8n orchestration ──────────────────────────────────────────────────────
N8N_WEBHOOK_BASE=https://your-n8n.cloud/webhook

# ─── Ops ────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
OUTBOUND_PAUSED=false                  # kill switch
